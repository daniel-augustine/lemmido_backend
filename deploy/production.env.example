# Copy to deploy/production.env on the server and fill in. Never commit the copy.
# Generate secrets with: openssl rand -hex 32

# Domains (DNS A records -> the VPS IP)
WEB_DOMAIN=lemmido.com
API_DOMAIN=api.lemmido.com
RT_DOMAIN=rt.lemmido.com

# Postgres (internal to Docker, not exposed)
POSTGRES_USER=lemmido
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lemmido

# Shared by web (signs), api and realtime (verify)
JWT_SECRET=change-me

# better-auth (web)
BETTER_AUTH_SECRET=change-me

# AWS Cognito app client. Allowed callback URL:
#   https://<WEB_DOMAIN>/api/auth/callback/cognito
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REGION=
COGNITO_USER_POOL_ID=

# Google
GOOGLE_ROUTES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Base location, where every job starts and ends (Thiruvalla, Kerala)
BASE_LAT=9.3835
BASE_LNG=76.5741
